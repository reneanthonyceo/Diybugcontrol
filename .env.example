# Copy to .env and fill in. .env is gitignored — never commit a real token.
#
# Your store's permanent domain. Not the custom domain: the Admin API only
# answers on the .myshopify.com one.
SHOPIFY_STORE=fcphwt-ms.myshopify.com

# Admin API access token from Settings → Apps and sales channels →
# Develop apps → your app → API credentials. Starts with shpat_.
# Scopes needed: write_products, write_publications, write_metaobjects, write_content
SHOPIFY_ADMIN_TOKEN=shpat_replace_me
