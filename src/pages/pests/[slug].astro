---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Glyph from '../../components/Glyph.astro';
import ProductCard from '../../components/ProductCard.astro';
import PestFinder from '../../components/PestFinder.astro';
import StarRating from '../../components/StarRating.astro';
import { pests, productsForPest, formatPrice, type Pest } from '../../data/catalog';

export function getStaticPaths() {
  return pests.map((pest) => ({ params: { slug: pest.slug }, props: { pest } }));
}

interface Props {
  pest: Pest;
}

const { pest } = Astro.props;
const matches = productsForPest(pest.slug);
const top = matches[0];

// Reviews left by people who treated this specific pest.
const reviews = matches
  .flatMap((product) =>
    product.reviews
      .filter((review) => review.pest === pest.slug)
      .map((review) => ({ ...review, product })),
  )
  .slice(0, 3);
---

<BaseLayout
  title={`${pest.name} — identification and treatment | DIY Bug Control`}
  description={`How to identify ${pest.name.toLowerCase()}, the treatment sequence that works, and the products for it. ${pest.tagline}`}
>
  <section class="hero">
    <div class="container hero-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/pests/">Pests</a></li>
          <li aria-current="page">{pest.name}</li>
        </ol>
      </nav>
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Identification and treatment</span>
          <h1>{pest.name}</h1>
          <p class="lede">{pest.tagline}</p>
          {top && (
            <a class="btn btn-accent" href={`/products/${top.slug}/`}>
              Start with {top.name} — {formatPrice(top.price)}
            </a>
          )}
        </div>
        <div class="hero-art" aria-hidden="true">
          <Glyph name={pest.glyph} size={104} />
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <section class="section">
      <div class="two-col">
        <div class="panel signs">
          <h2>Signs it's {pest.name.toLowerCase()}</h2>
          <ul class="check-list">
            {
              pest.signs.map((sign) => (
                <li>
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span>{sign}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="panel plan">
          <h2>Treatment sequence</h2>
          <ol class="plan-list">
            {
              pest.steps.map((step, i) => (
                <li>
                  <span class="plan-num tabular" aria-hidden="true">{i + 1}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p class="muted">{step.detail}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <span class="eyebrow">Recommended</span>
        <h2>What to use on {pest.name.toLowerCase()}</h2>
        <p>Listed in the order we'd apply them, not by price.</p>
      </div>
      <div class="grid-auto">
        {matches.map((product) => <ProductCard product={product} />)}
      </div>
    </section>

    {
      matches.length > 1 && (
        <section class="section">
          <div class="section-head">
            <span class="eyebrow">Side by side</span>
            <h2>Compare</h2>
          </div>
          <div class="scroll-x compare-wrap">
            <table class="compare">
              <caption class="visually-hidden">
                Products for {pest.name.toLowerCase()} compared by price, rating, coverage and stock
              </caption>
              <thead>
                <tr>
                  <th scope="col">Product</th>
                  <th scope="col">Price</th>
                  <th scope="col">Rating</th>
                  <th scope="col">Coverage</th>
                  <th scope="col">Stock</th>
                </tr>
              </thead>
              <tbody>
                {matches.map((product) => (
                  <tr>
                    <th scope="row">
                      <a href={`/products/${product.slug}/`}>{product.name}</a>
                      <span class="unit muted">{product.unit}</span>
                    </th>
                    <td class="tabular">{formatPrice(product.price)}</td>
                    <td class="tabular">{product.rating}</td>
                    <td>{product.coverage}</td>
                    <td>
                      <span class:list={['pill', product.inStock ? 'in' : 'out']}>
                        {product.inStock ? 'In stock' : 'Out of stock'}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      reviews.length > 0 && (
        <section class="section">
          <div class="section-head">
            <span class="eyebrow">From people who treated this</span>
            <h2>{pest.name} reviews</h2>
          </div>
          <div class="reviews">
            {reviews.map((review) => (
              <blockquote class="panel review">
                <StarRating rating={review.rating} size={15} compact />
                <h3>{review.title}</h3>
                <p class="muted">{review.body}</p>
                <footer class="review-foot">
                  <span class="who">{review.author}</span>
                  {review.verified && (
                    <span class="verified">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                      Verified purchase
                    </span>
                  )}
                  <a href={`/products/${review.product.slug}/`}>{review.product.name}</a>
                </footer>
              </blockquote>
            ))}
          </div>
        </section>
      )
    }

    <section class="section">
      <PestFinder current={pest.slug} heading="Dealing with something else?" />
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(160deg, var(--color-surface-alt), var(--color-background) 70%);
    border-bottom: 1px solid var(--color-border);
  }
  .hero-inner {
    padding-block: var(--space-8) var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    font-size: var(--text-small);
    color: var(--color-muted-foreground);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: var(--space-2);
    color: var(--color-muted-foreground);
  }
  .crumbs a {
    color: var(--color-muted-foreground);
  }
  .hero-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
    max-width: 46ch;
  }
  .hero h1 {
    font-size: var(--text-display);
    line-height: 1.08;
  }
  .lede {
    font-size: 1.1rem;
    color: var(--color-muted-foreground);
  }
  .hero-art {
    color: var(--color-primary);
    opacity: 0.55;
    flex: none;
  }

  .two-col {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    align-items: start;
  }
  .panel h2 {
    margin-bottom: var(--space-4);
  }
  .check-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .check-list li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    line-height: 1.5;
  }
  .check-list svg {
    flex: none;
    margin-top: 3px;
  }

  .plan-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .plan-list li {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .plan-num {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--color-surface-alt);
    color: var(--color-primary);
    border: 1.5px solid var(--color-primary);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .plan-list h3 {
    margin-bottom: var(--space-1);
    font-size: 1rem;
  }
  .plan-list p {
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .compare-wrap {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-card);
  }
  .compare {
    border-collapse: collapse;
    width: 100%;
    min-width: 640px;
    font-size: var(--text-small);
  }
  .compare th,
  .compare td {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .compare thead th {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted-foreground);
    font-weight: 700;
  }
  .compare tbody tr:last-child th,
  .compare tbody tr:last-child td {
    border-bottom: 0;
  }
  .compare tbody th {
    font-weight: 700;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .unit {
    font-weight: 400;
    font-size: 0.78rem;
  }
  .pill {
    display: inline-block;
    padding: 3px 9px;
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .pill.in {
    background: var(--color-surface-alt);
    color: var(--color-primary);
  }
  .pill.out {
    background: var(--color-border);
    color: var(--color-muted-foreground);
  }

  .reviews {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
  }
  .review {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .review h3 {
    font-size: 1rem;
  }
  .review p {
    font-size: var(--text-small);
    line-height: 1.55;
  }
  .review-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.78rem;
    margin-top: auto;
    padding-top: var(--space-2);
  }
  .who {
    font-weight: 700;
  }
  .verified {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--color-primary);
    font-weight: 700;
  }
</style>
