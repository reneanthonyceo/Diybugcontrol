{%- paginate collection.products by section.settings.per_page -%}
  <div class="container">
    <section class="section">
      <div class="section-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading }}
          {%- else -%}
            {{ collection.title }}
          {%- endif -%}
        </h2>
        {%- if collection.description != blank -%}
          <div class="rte">{{ collection.description }}</div>
        {%- endif -%}
        <p class="muted">
          {{ 'collection.product_count' | t: count: collection.products_count }}
        </p>
      </div>

      {%- if collection.products.size > 0 -%}
        <div class="grid-auto">
          {%- for product in collection.products -%}
            {%- liquid
              # Eager-load the first row so the largest contentful paint is not
              # waiting on a lazy image.
              assign card_loading = 'lazy'
              if forloop.index0 < 4
                assign card_loading = 'eager'
              endif
            -%}
            {% render 'product-card', product: product, loading: card_loading %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'accessibility.pagination' | t }}">
            {%- if paginate.previous -%}
              <a class="btn btn-secondary" href="{{ paginate.previous.url }}">
                {{ 'general.previous' | t }}
              </a>
            {%- endif -%}
            <span class="muted tabular">
              {{ 'general.page_of' | t: current: paginate.current_page, total: paginate.pages }}
            </span>
            {%- if paginate.next -%}
              <a class="btn btn-secondary" href="{{ paginate.next.url }}">
                {{ 'general.next' | t }}
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="muted">{{ 'collection.empty' | t }}</p>
      {%- endif -%}
    </section>
  </div>
{%- endpaginate -%}

{% stylesheet %}
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ],
  "enabled_on": {
    "templates": ["collection", "search"]
  }
}
{% endschema %}
