{% comment %}
  Collection — catalog layout.

  Centred hero, then a results toolbar, then a category sidebar beside the grid.
  The sidebar renders Shopify's native filters when the Search & Discovery app
  supplies them, and falls back to a plain category list when it does not, so
  the page is useful either way.

  The grid/list toggle is a link that sets ?view=list, not a script — it
  survives a shared URL and works with scripting disabled.
{% endcomment %}

{%- liquid
  assign view = 'grid'
  if request.get_params.view == 'list'
    assign view = 'list'
  endif
  assign guides_url = section.settings.guides_url
  assign sub_menu = section.settings.subcategory_menu
-%}

{% render 'breadcrumbs' %}

<div class="collection-hero">
  <div class="container collection-hero-inner">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte collection-hero-copy">{{ collection.description }}</div>
    {%- endif -%}
    {%- if guides_url != blank and section.settings.guides_label != blank -%}
      <a class="collection-guides" href="{{ guides_url }}">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="4" y="3" width="16" height="18" rx="2"></rect>
          <path d="M8 8h8M8 12h8M8 16h5"></path>
        </svg>
        {{ section.settings.guides_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{%- paginate collection.products by section.settings.per_page -%}
  <div class="collection-toolbar">
    <div class="container collection-toolbar-inner">
      <p class="result-count">
        {%- if collection.products_count > 0 -%}
          <strong class="tabular">
            {{ paginate.current_offset | plus: 1 }}-{{ paginate.current_offset | plus: paginate.page_size | at_most: collection.products_count }}
          </strong>
          {{ 'collection.of' | t }}
          <strong class="tabular">{{ collection.products_count }}</strong>
          {{ 'collection.results' | t }}
        {%- else -%}
          {{ 'collection.empty' | t }}
        {%- endif -%}
      </p>

      <div class="toolbar-controls">
        <form class="sort-form" method="get">
          {%- if view == 'list' -%}
            <input type="hidden" name="view" value="list">
          {%- endif -%}
          <label for="sort-by">{{ 'collection.sort_by' | t }}</label>
          <select id="sort-by" name="sort_by" onchange="this.form.submit()">
            {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
          <noscript><button type="submit" class="btn btn-secondary">{{ 'collection.apply' | t }}</button></noscript>
        </form>

        <div class="view-toggle" role="group" aria-label="{{ 'collection.view_label' | t }}">
          <a
            class="view-btn {% if view == 'grid' %}is-active{% endif %}"
            href="{{ request.path }}?{% if collection.sort_by %}sort_by={{ collection.sort_by }}{% endif %}"
            {% if view == 'grid' %}aria-current="true"{% endif %}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect>
            </svg>
            <span class="visually-hidden">{{ 'collection.view_grid' | t }}</span>
          </a>
          <a
            class="view-btn {% if view == 'list' %}is-active{% endif %}"
            href="{{ request.path }}?view=list{% if collection.sort_by %}&sort_by={{ collection.sort_by }}{% endif %}"
            {% if view == 'list' %}aria-current="true"{% endif %}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <rect x="3" y="4" width="18" height="4" rx="1"></rect>
              <rect x="3" y="10" width="18" height="4" rx="1"></rect>
              <rect x="3" y="16" width="18" height="4" rx="1"></rect>
            </svg>
            <span class="visually-hidden">{{ 'collection.view_list' | t }}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="collection-layout">
      <aside class="collection-sidebar">
        {%- if collection.filters.size > 0 -%}
          <form method="get" class="filter-form">
            {%- if collection.sort_by != blank -%}
              <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
            {%- endif -%}
            {%- for filter in collection.filters -%}
              <details class="filter-group" open>
                <summary>{{ filter.label }}</summary>
                {%- case filter.type -%}
                  {%- when 'list' -%}
                    <ul class="filter-list">
                      {%- for value in filter.values -%}
                        <li>
                          <label class="filter-option {% if value.count == 0 and value.active == false %}is-empty{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                            >
                            <span>{{ value.label }}</span>
                            <span class="filter-count tabular">{{ value.count }}</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- when 'price_range' -%}
                    <div class="filter-price">
                      <label>
                        <span class="visually-hidden">{{ 'collection.price_min' | t }}</span>
                        <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" placeholder="{{ 'collection.min' | t }}" min="0">
                      </label>
                      <span aria-hidden="true">&ndash;</span>
                      <label>
                        <span class="visually-hidden">{{ 'collection.price_max' | t }}</span>
                        <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" placeholder="{{ 'collection.max' | t }}" min="0">
                      </label>
                    </div>
                {%- endcase -%}
              </details>
            {%- endfor -%}
            <button type="submit" class="btn btn-primary btn-block">{{ 'collection.apply' | t }}</button>
            <a class="filter-clear" href="{{ collection.url }}">{{ 'collection.clear' | t }}</a>
          </form>
        {%- endif -%}

        {%- if sub_menu != blank and sub_menu.links.size > 0 -%}
          <nav class="sidebar-nav" aria-label="{{ 'collection.categories' | t }}">
            <h2 class="sidebar-heading">{{ 'collection.categories' | t }}</h2>
            <ul>
              {%- for link in sub_menu.links -%}
                <li>
                  <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
                  {%- if link.links.size > 0 -%}
                    <ul class="sidebar-sub">
                      {%- for child in link.links -%}
                        <li><a href="{{ child.url }}" {% if child.current %}aria-current="page"{% endif %}>{{ child.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </aside>

      <div class="collection-main">
        {%- if sub_menu != blank and sub_menu.links.size > 0 and section.settings.show_tiles -%}
          <section class="subcat-panel">
            <h2 class="subcat-heading">
              {{ 'collection.shop_by_category' | t: title: collection.title }}
            </h2>
            <ul class="subcat-row">
              {%- for link in sub_menu.links -%}
                <li>
                  <a class="subcat-tile" href="{{ link.url }}">
                    <span class="subcat-art">
                      {%- if link.object.featured_image -%}
                        {{ link.object.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: '' }}
                      {%- else -%}
                        {% render 'glyph', glyph: link.object.metafields.dbc.glyph.value, size: 44 %}
                      {%- endif -%}
                    </span>
                    <span class="subcat-label">{{ link.title }}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}

        {%- if collection.products.size > 0 -%}
          <div class="{% if view == 'list' %}product-list{% else %}grid-auto{% endif %}">
            {%- for product in collection.products -%}
              {%- liquid
                assign card_loading = 'lazy'
                if forloop.index0 < 5
                  assign card_loading = 'eager'
                endif
              -%}
              {% render 'product-card', product: product, loading: card_loading %}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="{{ 'accessibility.pagination' | t }}">
              {%- if paginate.previous -%}
                <a class="btn btn-secondary" href="{{ paginate.previous.url }}">{{ 'general.previous' | t }}</a>
              {%- endif -%}
              <span class="muted tabular">
                {{ 'general.page_of' | t: current: paginate.current_page, total: paginate.pages }}
              </span>
              {%- if paginate.next -%}
                <a class="btn btn-secondary" href="{{ paginate.next.url }}">{{ 'general.next' | t }}</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <p class="muted">{{ 'collection.empty' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "subcategory_menu",
      "label": "Sidebar categories",
      "info": "Shown in the sidebar and as the category tile row. Point it at a menu of sub-collections."
    },
    {
      "type": "checkbox",
      "id": "show_tiles",
      "label": "Show category tile row",
      "default": true
    },
    {
      "type": "text",
      "id": "guides_label",
      "label": "Guides link label",
      "default": "View treatment guides and videos"
    },
    {
      "type": "url",
      "id": "guides_url",
      "label": "Guides link"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ],
  "enabled_on": {
    "templates": ["collection", "search"]
  }
}
{% endschema %}
