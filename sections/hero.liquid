<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.body != blank -%}
        <div class="hero-lede">{{ section.settings.body }}</div>
      {%- endif -%}

      <div class="hero-actions">
        {%- if section.settings.cta_label != blank -%}
          {% comment %}
            The one accent CTA on the page. MASTER.md restricts the accent colour
            to a single action per viewport.
          {% endcomment %}
          <a class="btn btn-accent" href="{{ section.settings.cta_url }}">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="btn btn-secondary" href="{{ section.settings.cta2_url }}">
            {{ section.settings.cta2_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <aside class="hero-aside">
        {%- if section.settings.aside_heading != blank -%}
          <h2 class="hero-aside-title">{{ section.settings.aside_heading }}</h2>
        {%- endif -%}
        <ul class="hero-aside-list">
          {%- for block in section.blocks -%}
            {%- assign pest = block.settings.pest -%}
            {%- if pest != blank -%}
              <li {{ block.shopify_attributes }}>
                <a href="{{ pest.url }}">
                  <span class="hero-aside-icon" aria-hidden="true">
                    {% render 'glyph', glyph: pest.metafields.dbc.glyph.value, size: 26 %}
                  </span>
                  <span class="hero-aside-copy">
                    <span class="hero-aside-name">{{ pest.title }}</span>
                    {%- assign signs = pest.metafields.dbc.signs.value -%}
                    {%- if signs != blank and signs.size > 0 -%}
                      <span class="hero-aside-note">{{ signs.first }}</span>
                    {%- endif -%}
                  </span>
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </aside>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hero {
    background: linear-gradient(160deg, var(--color-surface-alt), var(--color-background) 65%);
    border-bottom: 1px solid var(--color-border);
  }
  .hero-inner {
    padding-block: clamp(var(--space-12), 8vw, 96px);
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-inner:has(.hero-aside) {
      grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    }
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 44ch;
  }
  .hero h1 {
    font-size: var(--text-display);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .hero-lede,
  .hero-lede p {
    font-size: 1.125rem;
    color: var(--color-muted-foreground);
    line-height: 1.55;
    max-width: var(--measure);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .hero-aside {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .hero-aside-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted-foreground);
  }
  .hero-aside-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .hero-aside-list a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-foreground);
    text-decoration: none;
    transition: background-color var(--duration-hover) var(--ease-out);
  }
  .hero-aside-list a:hover { background: var(--color-surface-alt); }
  .hero-aside-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
    color: var(--color-primary);
  }
  .hero-aside-copy {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .hero-aside-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .hero-aside-note {
    font-size: 0.78rem;
    color: var(--color-muted-foreground);
    line-height: 1.4;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Do it yourself, do it once"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You have a pest problem. Let's get it right the first time."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Most DIY treatments fail for the same handful of reasons — wrong product, wrong placement, no follow-up. We sell the products and tell you exactly how to use them.</p>"
    },
    {
      "type": "header",
      "content": "Primary action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Label",
      "default": "Find your pest"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Secondary action"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Label",
      "default": "Browse all products"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Sidebar"
    },
    {
      "type": "text",
      "id": "aside_heading",
      "label": "Heading",
      "default": "Treated most this month"
    }
  ],
  "blocks": [
    {
      "type": "pest",
      "name": "Pest",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "pest",
          "label": "Pest collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
