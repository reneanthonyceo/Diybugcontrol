<div class="container">
  <section class="section">
    <div class="section-head">
      <span class="eyebrow">404</span>
      <h1>{{ 'general.not_found.title' | t }}</h1>
      <p>{{ 'general.not_found.body' | t }}</p>
    </div>
    <div class="not-found-actions">
      <a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">
        {{ 'general.not_found.shop' | t }}
      </a>
      <a class="btn btn-secondary" href="{{ routes.root_url }}">
        {{ 'general.not_found.home' | t }}
      </a>
    </div>
  </section>
</div>

{% stylesheet %}
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404",
  "tag": "section",
  "settings": [],
  "enabled_on": {
    "templates": ["404"]
  }
}
{% endschema %}
