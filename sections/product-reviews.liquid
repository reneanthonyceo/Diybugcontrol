{% comment %}
  Product reviews.

  Review content comes from an app, not from this theme. The section accepts
  `@app` blocks so Judge.me, Okendo, Yotpo, Loox or Shopify's own review app can
  be dropped in from the theme editor with no code change — hardcoding one
  vendor would make switching a theme edit.

  The aggregate summary above the app block is rendered from Shopify's standard
  `reviews.rating` and `reviews.rating_count` metafields, which every major
  review app writes to. If no rating exists yet, the whole section renders
  nothing rather than an empty five-star row.
{% endcomment %}

{%- liquid
  assign rating_data = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign has_rating = false
  if rating_data != blank and rating_count > 0
    assign has_rating = true
  endif
-%}

{%- if has_rating or section.blocks.size > 0 -%}
  <div class="container">
    <section class="section" id="reviews">
      <div class="section-head">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>

      <div class="reviews-layout">
        {%- if has_rating -%}
          <div class="panel reviews-summary">
            <div class="reviews-agg">
              <span class="reviews-agg-value tabular">{{ rating_data.rating }}</span>
              {% render 'star-rating', rating: rating_data.rating, size: 17, compact: true %}
              <span class="reviews-agg-count muted tabular">
                {{ 'product.rating.count' | t: count: rating_count }}
              </span>
            </div>
            <p class="reviews-scale muted">
              {{ 'product.rating.scale' | t: max: rating_data.scale_max }}
            </p>
          </div>
        {%- endif -%}

        <div class="reviews-app">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div {{ block.shopify_attributes }}>
                {% render block %}
              </div>
            {%- endfor -%}
          {%- else -%}
            <p class="muted">{{ 'product.reviews_empty' | t }}</p>
          {%- endif -%}
        </div>
      </div>
    </section>
  </div>
{%- endif -%}

{% stylesheet %}
  .reviews-layout {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: minmax(240px, 300px) 1fr;
    align-items: start;
  }
  .reviews-layout:not(:has(.reviews-summary)) {
    grid-template-columns: 1fr;
  }
  @media (max-width: 720px) {
    .reviews-layout { grid-template-columns: 1fr; }
  }
  .reviews-summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: sticky;
    top: 88px;
  }
  .reviews-agg {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }
  .reviews-agg-value {
    font-family: var(--font-heading);
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1;
  }
  .reviews-agg-count { font-size: var(--text-small); }
  .reviews-scale { font-size: 0.78rem; }
  .reviews-app { min-width: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What customers report"
    },
    {
      "type": "paragraph",
      "content": "Add your review app's block here. The rating summary on the left is read from the standard reviews metafields and needs no configuration."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
