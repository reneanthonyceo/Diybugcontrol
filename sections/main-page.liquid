<div class="container">
  <section class="section">
    <div class="section-head">
      <h1>{{ page.title }}</h1>
    </div>
    {%- if page.content != blank -%}
      <div class="rte prose">{{ page.content }}</div>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": [],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
