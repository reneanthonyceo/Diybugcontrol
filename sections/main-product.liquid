{%- liquid
  assign glyph = product.metafields.dbc.glyph.value | default: 'bug'
  assign unit = product.metafields.dbc.unit.value
  assign summary = product.metafields.dbc.summary.value
  assign coverage = product.metafields.dbc.coverage.value
  assign application_steps = product.metafields.dbc.application_steps.value
  assign current_variant = product.selected_or_first_available_variant
-%}

<div class="container">
  <nav class="crumbs" aria-label="{{ 'accessibility.breadcrumb' | t }}">
    <ol>
      <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
      {%- if collection.url -%}
        <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
      {%- endif -%}
      <li aria-current="page">{{ product.title }}</li>
    </ol>
  </nav>

  {% comment %} Above the fold: product, aggregate rating, buy box. {% endcomment %}
  <section class="product-lede">
    <div class="product-art">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 900
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '400, 600, 900',
            sizes: '(min-width: 900px) 520px, 92vw',
            alt: product.featured_media.alt | default: product.title
        }}
      {%- else -%}
        {% render 'glyph', glyph: glyph, size: 120 %}
      {%- endif -%}
      {%- if product.metafields.dbc.badge.value != blank -%}
        <span class="card-badge">{{ product.metafields.dbc.badge.value }}</span>
      {%- endif -%}
    </div>

    <div class="product-buy">
      <h1>{{ product.title }}</h1>
      {% render 'star-rating', product: product %}

      {%- if summary != blank -%}
        <p class="product-summary">{{ summary }}</p>
      {%- endif -%}

      <div class="product-price-row">
        <span class="product-price tabular">{{ current_variant.price | money }}</span>
        {%- if unit != blank -%}
          <span class="card-unit muted">{{ unit }}</span>
        {%- endif -%}
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s class="muted tabular">{{ current_variant.compare_at_price | money }}</s>
        {%- endif -%}
      </div>

      <p class="product-stock">
        <span class="stock-dot {% if product.available %}is-in{% else %}is-out{% endif %}" aria-hidden="true"></span>
        {%- if product.available -%}
          {{ section.settings.in_stock_text | default: 'In stock' }}
        {%- else -%}
          {{ 'product.sold_out' | t }}
        {%- endif -%}
      </p>

      {%- form 'product', product, id: 'product-form', class: 'product-form' -%}
        {%- comment -%}
          A single select bound to `id` rather than per-option `options[]` inputs.
          Mixing the two conflicts, and this variant needs no JavaScript to stay
          correct — the form works with scripting disabled.
        {%- endcomment -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- else -%}
          <div class="field">
            <label for="variant-select">{{ 'product.options' | t }}</label>
            <select id="variant-select" name="id" form="product-form">
              {%- for variant in product.variants -%}
                <option
                  value="{{ variant.id }}"
                  {% if variant == current_variant %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }} &middot; {{ variant.price | money }}
                  {%- unless variant.available %} &middot; {{ 'product.sold_out' | t }}{% endunless -%}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        <div class="field field-qty">
          <label for="quantity">{{ 'product.quantity' | t }}</label>
          <input
            id="quantity"
            name="quantity"
            type="number"
            min="1"
            value="1"
            inputmode="numeric"
            form="product-form"
          >
        </div>

        {% comment %}
          The single accent CTA on this page — see MASTER.md. Everything else on
          a product page is primary green or secondary.
        {% endcomment %}
        <button
          type="submit"
          name="add"
          class="btn btn-accent btn-block"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {%- if current_variant.available -%}
            {{ 'product.add_to_cart' | t }}
          {%- else -%}
            {{ 'product.sold_out' | t }}
          {%- endif -%}
        </button>
      {%- endform -%}

      {%- assign pest_collections = product.collections | where: 'metafields.dbc.is_pest.value', true -%}
      {%- if pest_collections.size > 0 -%}
        <div class="product-treats">
          <span class="product-treats-label">{{ 'product.treats' | t }}</span>
          <ul>
            {%- for pest in pest_collections -%}
              <li><a href="{{ pest.url }}">{{ pest.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </section>

  <section class="section">
    <div class="detail-grid">
      {% render 'metafield-list',
        heading: 'What it kills',
        items: product.metafields.dbc.kills.value
      %}

      {%- assign use_where = product.metafields.dbc.use_where.value -%}
      {%- if use_where != blank and use_where.size > 0 -%}
        <div class="panel">
          <h2>Where to use it</h2>
          <ul class="bullets">
            {%- for item in use_where -%}
              <li>{{ item }}</li>
            {%- endfor -%}
          </ul>
          {%- if coverage != blank -%}
            <p class="product-coverage">
              <span class="muted">Coverage</span>
              <strong>{{ coverage }}</strong>
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {% render 'metafield-list',
        heading: 'Safety',
        items: product.metafields.dbc.safety.value,
        modifier: 'panel-safety',
        icon: 'shield',
        note: section.settings.label_note
      %}
    </div>
  </section>

  {%- if application_steps != blank and application_steps.size > 0 -%}
    <section class="section">
      <div class="section-head">
        <span class="eyebrow">Application</span>
        <h2>How to apply it</h2>
        <p>The sequence matters more than the product. Follow it in order.</p>
      </div>
      <ol class="steps">
        {%- for step in application_steps -%}
          <li>
            <span class="step-num tabular" aria-hidden="true">{{ forloop.index }}</span>
            <span>{{ step }}</span>
          </li>
        {%- endfor -%}
      </ol>
    </section>
  {%- endif -%}

  {%- if product.description != blank -%}
    <section class="section">
      <div class="section-head">
        <h2>{{ 'product.description' | t }}</h2>
      </div>
      <div class="rte prose">{{ product.description }}</div>
    </section>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-lede {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    align-items: start;
    padding-bottom: var(--space-8);
  }
  .product-art {
    position: relative;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    background: linear-gradient(150deg, var(--color-surface-alt), var(--color-border));
    border-radius: var(--radius-lg);
    color: var(--color-primary);
    overflow: hidden;
  }
  .product-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-buy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .product-buy h1 { font-size: clamp(1.75rem, 4vw, 2.4rem); }
  .product-summary {
    color: var(--color-muted-foreground);
    line-height: 1.55;
    max-width: var(--measure);
  }
  .product-price-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .product-price {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
  }
  .product-stock {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    font-weight: 700;
  }
  .stock-dot {
    width: 9px;
    height: 9px;
    border-radius: var(--radius-full);
  }
  .stock-dot.is-in { background: var(--color-primary); }
  .stock-dot.is-out { background: var(--color-muted-foreground); }

  .product-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    max-width: 420px;
  }
  .variant-fields {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .field label {
    font-size: var(--text-small);
    font-weight: 700;
  }
  .field select,
  .field input {
    height: var(--input-height);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-interactive);
    padding: 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-body);
    background: var(--color-card);
    color: var(--color-foreground);
  }
  .field-qty { max-width: 120px; }

  .product-treats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }
  .product-treats-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted-foreground);
    font-weight: 700;
  }
  .product-treats ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .product-treats a {
    display: inline-block;
    padding: 5px var(--space-3);
    border: 1px solid var(--color-border-interactive);
    border-radius: var(--radius-full);
    font-size: var(--text-small);
    text-decoration: none;
  }
  .product-treats a:hover {
    background: var(--color-surface-alt);
    border-color: var(--color-primary);
  }
  .product-coverage {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--text-small);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "in_stock_text",
      "label": "In-stock message",
      "default": "In stock — ships same day before 2pm"
    },
    {
      "type": "textarea",
      "id": "label_note",
      "label": "Label disclaimer",
      "info": "Shown under the safety panel. Required reading for regulated products.",
      "default": "Read the product label in full before use. Label directions are the legal instructions and override anything written here."
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
