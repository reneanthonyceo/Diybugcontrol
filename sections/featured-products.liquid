<div class="container">
  <section class="section">
    {%- if section.settings.heading != blank -%}
      <div class="section-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}
          <p>{{ section.settings.body }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign source = section.settings.collection -%}
    {%- if source != blank and source.products.size > 0 -%}
      <div class="grid-auto">
        {%- for product in source.products limit: section.settings.count -%}
          {% render 'product-card', product: product, loading: 'lazy' %}
        {%- endfor -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <div>
          <a class="btn btn-secondary" href="{{ source.url }}">{{ section.settings.link_label }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="muted">{{ 'product.collection_empty' | t }}</p>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Most bought"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best sellers"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products shown",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
