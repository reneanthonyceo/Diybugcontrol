<header class="site-header">
  <div class="container header-bar">
    <a class="header-brand" href="{{ routes.root_url }}">
      {% render 'glyph', glyph: 'bug', size: 30 %}
      <span class="header-brand-name">{{ shop.name }}</span>
    </a>

    <nav aria-label="{{ 'accessibility.main_nav' | t }}">
      <ul class="header-nav">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a
              href="{{ link.url }}"
              {% if link.current or link.child_active %}aria-current="page"{% endif %}
            >
              {{ link.title }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <a class="header-cart" href="{{ routes.cart_url }}">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.55L21 8H6"></path>
        <circle cx="10" cy="20" r="1.2"></circle>
        <circle cx="18" cy="20" r="1.2"></circle>
      </svg>
      <span>{{ 'cart.title' | t }}</span>
      <span class="header-cart-count tabular" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
        {{ cart.item_count }}
      </span>
    </a>
  </div>
</header>

{% stylesheet %}
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-card);
    border-bottom: 1px solid var(--color-border);
  }
  .header-bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 68px;
    flex-wrap: wrap;
    padding-block: var(--space-2);
  }
  .header-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-foreground);
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    margin-right: auto;
  }
  .header-brand svg {
    color: var(--color-primary);
    flex: none;
  }
  .header-brand-name { white-space: nowrap; }
  .header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min);
    padding: 0 var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-foreground);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: 700;
  }
  .header-nav a:hover { background: var(--color-surface-alt); }
  .header-nav a[aria-current='page'] {
    color: var(--color-primary);
    box-shadow: inset 0 -2px 0 var(--color-primary);
    border-radius: 0;
  }
  .header-cart {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-target-min);
    padding: 0 var(--space-4);
    border: 1.5px solid var(--color-primary);
    border-radius: var(--radius-md);
    color: var(--color-primary);
    text-decoration: none;
    font-size: var(--text-small);
    font-weight: 700;
  }
  .header-cart:hover { background: var(--color-surface-alt); }
  .header-cart-count {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 0.72rem;
  }
  @media (max-width: 560px) {
    .header-bar { justify-content: space-between; }
    .site-header nav { order: 3; width: 100%; }
    .header-nav { justify-content: space-between; width: 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
