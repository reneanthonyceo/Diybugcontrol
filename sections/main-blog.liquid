{%- paginate blog.articles by section.settings.per_page -%}
  <div class="container">
    <section class="section">
      <div class="section-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1>{{ blog.title }}</h1>
        {%- if section.settings.body != blank -%}
          <p>{{ section.settings.body }}</p>
        {%- endif -%}
      </div>

      {%- if blog.articles.size > 0 -%}
        <div class="article-grid">
          {%- for article in blog.articles -%}
            <article class="card article-card">
              <a class="card-hit" href="{{ article.url }}">
                <span class="visually-hidden">{{ article.title }}</span>
              </a>
              {%- if article.image -%}
                <div class="card-art">
                  {{
                    article.image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '240, 360, 600',
                      sizes: '(min-width: 768px) 340px, 90vw',
                      alt: article.image.alt | default: article.title
                  }}
                </div>
              {%- endif -%}
              <div class="card-body">
                <h2 class="card-name">{{ article.title }}</h2>
                <p class="card-summary">{{ article.excerpt_or_content | strip_html | truncate: 150 }}</p>
                <time class="muted article-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: '%B %-d, %Y' }}
                </time>
              </div>
            </article>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'accessibility.pagination' | t }}">
            {%- if paginate.previous -%}
              <a class="btn btn-secondary" href="{{ paginate.previous.url }}">{{ 'general.previous' | t }}</a>
            {%- endif -%}
            <span class="muted tabular">
              {{ 'general.page_of' | t: current: paginate.current_page, total: paginate.pages }}
            </span>
            {%- if paginate.next -%}
              <a class="btn btn-secondary" href="{{ paginate.next.url }}">{{ 'general.next' | t }}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="muted">{{ 'blog.empty' | t }}</p>
      {%- endif -%}
    </section>
  </div>
{%- endpaginate -%}

{% stylesheet %}
  .article-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
  .article-card .card-body { gap: var(--space-3); }
  .article-card .card-summary {
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }
  .article-date {
    font-size: 0.78rem;
    margin-top: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Guides"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body",
      "default": "Product choice matters less than most people expect. Placement, timing, and follow-up are what separate a fix from a cycle."
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Articles per page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    }
  ],
  "enabled_on": {
    "templates": ["blog"]
  }
}
{% endschema %}
