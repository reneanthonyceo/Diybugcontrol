<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#047857" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0b1a14" media="(prefers-color-scheme: dark)">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% comment %} Fonts are self-hosted and subset to latin, weight axis preserved. {% endcomment %}
    {{ 'Rubik.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'NunitoSans.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <style>
      @font-face {
        font-family: 'Rubik';
        src: url({{ 'Rubik.woff2' | asset_url }}) format('woff2');
        font-weight: 300 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Nunito Sans';
        src: url({{ 'NunitoSans.woff2' | asset_url }}) format('woff2');
        font-weight: 200 900;
        font-style: normal;
        font-display: swap;
      }
    </style>

    {{ content_for_header }}

    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% comment %}
      No theme JavaScript. Cart count, variant selection, and quantity updates
      are all server-rendered or plain form posts, so the storefront works with
      scripting disabled and ships nothing to parse.
    {% endcomment %}
  </body>
</html>
