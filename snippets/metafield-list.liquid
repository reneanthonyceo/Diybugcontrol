{% comment %}
  Renders a list metafield as a bulleted panel, or nothing when empty.

  Accepts:
  - heading  {String}  panel heading
  - items    {Array}   a list.single_line_text_field metafield value
  - modifier {String}  optional extra class, e.g. 'panel-safety'
  - note     {String}  optional footnote below the list
  - icon     {String}  optional: 'shield' renders the safety mark

  Usage:
    {% render 'metafield-list',
       heading: 'What it kills',
       items: product.metafields.dbc.kills.value %}
{% endcomment %}

{%- if items != blank and items.size > 0 -%}
  <div class="panel {{ modifier }}">
    <h2>
      {%- if icon == 'shield' -%}
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l7.5 3.2v5c0 4.4-3.1 8.5-7.5 9.8-4.4-1.3-7.5-5.4-7.5-9.8v-5z"></path>
          <path d="M12 9v4M12 16.2v.01"></path>
        </svg>
      {%- endif -%}
      {{ heading }}
    </h2>
    <ul class="bullets">
      {%- for item in items -%}
        <li>{{ item }}</li>
      {%- endfor -%}
    </ul>
    {%- if note != blank -%}
      <p class="panel-note">{{ note }}</p>
    {%- endif -%}
  </div>
{%- endif -%}
