{% comment %}
  Line-art category glyphs.

  Schematic on purpose — a merchant without product photography is better served
  by an honest diagram than by a stock image. Each pest has its own silhouette;
  a grid of identical bugs defeats the point of a pest finder.

  Accepts:
  - glyph {String} one of: bug, ant, bedbug, termite, spider, flea, rodent,
    mosquito, spray, trap, granule. Falls back to bug.
  - size  {Number} pixel size, default 40.

  Usage: {% render 'glyph', glyph: product.metafields.dbc.glyph.value, size: 56 %}
{% endcomment %}

{%- liquid
  assign icon_size = size | default: 40

  case glyph
    when 'ant'
      assign d = 'M5.2 12a1.8 1.8 0 1 0 3.6 0 1.8 1.8 0 1 0-3.6 0M9.6 12a2 2 0 1 0 4 0 2 2 0 1 0-4 0M14.6 12a2.9 2.9 0 1 0 5.8 0 2.9 2.9 0 1 0-5.8 0M10.4 10.2 9.4 7M11.4 13.8 10.6 17M13 10.4 13.4 7M13.4 13.6 14 17M16.6 9.6 16.4 6.6M17 14.6l.4 3M5.8 10.8 4 8.4M6.2 13.4 4.4 15.6'
    when 'bedbug'
      assign d = 'M12 5.5c3.4 0 5.6 3 5.6 6.6S15.2 19 12 19s-5.6-3.3-5.6-6.9S8.6 5.5 12 5.5zM7 11.5h10M7.3 14.6h9.4M10.2 5.9 8.6 3.7M13.8 5.9l1.6-2.2M6.6 9.6 4.4 8.5M6.4 13.1H4.2M7.3 16.5 5.3 17.9M17.4 9.6l2.2-1.1M17.6 13.1h2.2M16.7 16.5l2 1.4'
    when 'termite'
      assign d = 'M4.5 12a2 2 0 1 0 4 0 2 2 0 1 0-4 0M9 9.6h8.5c1.4 0 2.5 1.1 2.5 2.4s-1.1 2.4-2.5 2.4H9zM12 9.6v4.8M15 9.6v4.8M5.4 10.3 3.6 8.4M5.4 13.7 3.6 15.6M10 14.4 9.4 17.2M13.6 14.4v2.8M10 9.6 9.4 6.8M13.6 9.6V6.8'
    when 'spider'
      assign d = 'M10 8.6a2 2 0 1 0 4 0 2 2 0 1 0-4 0M8.8 14a3.2 3.2 0 1 0 6.4 0 3.2 3.2 0 1 0-6.4 0M9.7 10.2 5.6 7.6M9 12.3 4.3 11.2M9.2 15.4 4.9 16.6M10.3 17.5 6.7 20M14.3 10.2l4.1-2.6M15 12.3l4.7-1.1M14.8 15.4l4.3 1.2M13.7 17.5l3.6 2.5'
    when 'flea'
      assign d = 'M14.6 7.4c2.4 1.4 3.6 4.3 2.8 7-.8 2.8-3.4 4.5-6.1 4.1-2.7-.4-4.6-2.8-4.4-5.5.2-2.7 2.3-5 5-5.5M9.2 13.8 5.3 16.6M11.4 18.3 10 21.4M16.2 17.2l2.6 2.9M14.2 7.1 13.4 4.2M15.8 7.8 18 5.7'
    when 'rodent'
      assign d = 'M15 9a4 4 0 1 0-6.6 3A5 5 0 0 0 5 16.5 3.5 3.5 0 0 0 8.5 20h6a3 3 0 0 0 0-6M17 7.5a2 2 0 1 0 0-.1M10.5 9h.01M20 18c-1.5 0-3 .8-4 2'
    when 'mosquito'
      assign d = 'M12 10.5v7M12 17.5c-1.5 0-2.5-.8-3-1.5M12 17.5c1.5 0 2.5-.8 3-1.5M10.5 8.5a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0M11 7 8.5 4.5M13 7l2.5-2.5M10.5 11 4 8.5M13.5 11 20 8.5M10.5 13.5 5 14M13.5 13.5 19 14'
    when 'spray'
      assign d = 'M9 8h5a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-3a2 2 0 0 1-2-2zM10 8V5.5A1.5 1.5 0 0 1 11.5 4h1M13 4h4M18 6.5h.01M20 4.5h.01M19 9h.01M9.5 12.5h5'
    when 'trap'
      assign d = 'M4 17h16v3H4zM6 17V9a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8M9.5 11.5h5M12 7V4'
    when 'granule'
      assign d = 'M6 9h.01M10 7h.01M14 9h.01M18 7h.01M8 12h.01M12 11h.01M16 12h.01M5 20h14a1 1 0 0 0 1-1v-3H4v3a1 1 0 0 0 1 1z'
    else
      assign d = 'M12 6v3M9.5 7 12 9l2.5-2M8 11h8l.8 5.2a4.9 4.9 0 0 1-9.6 0zM5 13H3M21 13h-2M6 18l-2 2M18 18l2 2M6.5 9.5 4.5 7.5M17.5 9.5l2-2'
  endcase
-%}

<svg
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="{{ d }}"></path>
</svg>
