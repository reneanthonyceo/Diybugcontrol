{% comment %}
  Product card.

  The whole card is a single link with one accessible name — no competing
  add-to-cart button. That is deliberate: MASTER.md limits the accent colour to
  one CTA per viewport, and a grid of twelve orange buttons destroys that.
  Purchase happens on the product page.

  Accepts:
  - product {Product} required
  - loading {String} 'lazy' or 'eager', default 'lazy'

  Usage: {% render 'product-card', product: product %}
{% endcomment %}

{%- liquid
  assign img_loading = loading | default: 'lazy'
  assign glyph = product.metafields.dbc.glyph.value | default: 'bug'
  assign unit = product.metafields.dbc.unit.value
-%}

<article class="card">
  <a class="card-hit" href="{{ product.url }}">
    <span class="visually-hidden">{{ product.title }}</span>
  </a>

  <div class="card-art">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 600
        | image_tag:
          loading: img_loading,
          widths: '240, 360, 480, 600',
          sizes: '(min-width: 768px) 300px, 45vw',
          alt: product.featured_media.alt | default: product.title
      }}
    {%- else -%}
      {% render 'glyph', glyph: glyph, size: 56 %}
    {%- endif -%}

    {%- if product.metafields.dbc.badge.value != blank -%}
      <span class="card-badge">{{ product.metafields.dbc.badge.value }}</span>
    {%- endif -%}
    {%- unless product.available -%}
      <span class="card-badge is-out">{{ 'product.sold_out' | t }}</span>
    {%- endunless -%}
  </div>

  <div class="card-body">
    <h3 class="card-name">{{ product.title }}</h3>

    {%- assign sku = product.selected_or_first_available_variant.sku -%}
    {%- if sku != blank -%}
      <span class="card-sku">{{ 'product.sku' | t: sku: sku }}</span>
    {%- endif -%}

    {% render 'star-rating', product: product, size: 13 %}

    {%- if product.metafields.dbc.summary.value != blank -%}
      <p class="card-summary">{{ product.metafields.dbc.summary.value }}</p>
    {%- else -%}
      <p class="card-summary">{{ product.description | strip_html | truncate: 90 }}</p>
    {%- endif -%}

    <div class="card-foot">
      <span class="card-price tabular">
        {%- if product.price_varies -%}
          {{ 'product.price.from' | t: price: product.price_min | money }}
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </span>
      {%- if product.compare_at_price > product.price -%}
        <span class="card-compare tabular">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
      {%- if unit != blank -%}
        <span class="card-unit muted">{{ unit }}</span>
      {%- endif -%}
    </div>

    <span class="card-stock {% if product.available %}is-in{% else %}is-out{% endif %}">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {%- if product.available -%}
          <path d="M20 6 9 17l-5-5"></path>
        {%- else -%}
          <path d="M18 6 6 18M6 6l12 12"></path>
        {%- endif -%}
      </svg>
      {%- if product.available -%}
        {{ 'product.in_stock' | t }}
      {%- else -%}
        {{ 'product.sold_out' | t }}
      {%- endif -%}
    </span>
  </div>
</article>
