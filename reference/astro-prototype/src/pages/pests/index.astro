---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Glyph from '../../components/Glyph.astro';
import { pests, productsForPest } from '../../data/catalog';
---

<BaseLayout
  title="Find your pest | DIY Bug Control"
  description="Identify what you're dealing with, then get the treatment sequence and products for it. Roaches, ants, bed bugs, rodents, mosquitoes, termites, spiders and fleas."
>
  <div class="container">
    <section class="section">
      <div class="section-head">
        <span class="eyebrow">Start here</span>
        <h2>Find your pest</h2>
        <p>
          Identification comes before treatment — the right product depends entirely on
          the species. Each page covers the signs, the sequence, and what to use.
        </p>
      </div>

      <ul class="list">
        {
          pests.map((pest) => (
            <li>
              <a class="row" href={`/pests/${pest.slug}/`}>
                <span class="icon" aria-hidden="true">
                  <Glyph name={pest.glyph} size={36} />
                </span>
                <span class="copy">
                  <span class="name">{pest.name}</span>
                  <span class="tagline muted">{pest.tagline}</span>
                </span>
                <span class="count muted tabular">
                  {productsForPest(pest.slug).length} products
                </span>
                <svg class="chev" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 6 6 6-6 6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-foreground);
    transition:
      border-color var(--duration-hover) var(--ease-out),
      transform var(--duration-card) var(--ease-out),
      box-shadow var(--duration-card) var(--ease-out);
  }
  .row:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
    color: var(--color-primary);
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }
  .name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.1rem;
  }
  .tagline {
    font-size: var(--text-small);
    line-height: 1.45;
  }
  .count {
    font-size: var(--text-small);
    white-space: nowrap;
    flex: none;
  }
  .chev {
    flex: none;
    color: var(--color-primary);
  }
  @media (max-width: 560px) {
    .count {
      display: none;
    }
  }
</style>
